# Git configuration
# Managed by dotfiles - https://github.com/georgeOsdDev/dotfiles
# NOTE: Credentials should be configured in ~/.gitconfig.local (not committed)

[core]
	longpaths = true

[init]
	defaultBranch = main

[fetch]
	prune = true

[alias]
	st = status --short --branch
	lg = log --graph --decorate --oneline -20
	un = restore --staged

# Include local overrides (email, credentials, machine-specific settings)
[include]
	path = ~/.gitconfig.local
