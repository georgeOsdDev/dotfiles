{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "mode": "full",
  "schedule": ["before 9am on Monday"],
  "timezone": "Asia/Tokyo",
  "labels": ["dependencies"],
  "packageRules": [
    {
      "description": "Automerge patch updates",
      "matchUpdateTypes": ["patch"],
      "automerge": true
    },
    {
      "description": "Group mise tool updates",
      "matchManagers": ["mise"],
      "groupName": "mise tools"
    },
    {
      "description": "Group cargo crate updates",
      "matchManagers": ["cargo"],
      "groupName": "cargo tools"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update mise version in install.sh",
      "fileMatch": ["^install\\.sh$"],
      "matchStrings": ["MISE_VERSION=\"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "jdx/mise",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$"
    }
  ],
  "mise": {
    "enabled": true,
    "fileMatch": ["wsl/mise/config\\.toml$"]
  },
  "cargo": {
    "enabled": true,
    "fileMatch": ["wsl/cargo/Cargo\\.toml$"]
  },
  "npm": {
    "enabled": true,
    "fileMatch": ["wsl/npm/package\\.json$"]
  }
}
