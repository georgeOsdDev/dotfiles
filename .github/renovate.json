{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "schedule": ["before 9am on Monday"],
  "timezone": "Asia/Tokyo",
  "labels": ["dependencies"],
  "packageRules": [
    {
      "description": "Automerge patch updates",
      "matchUpdateTypes": ["patch"],
      "automerge": true
    },
    {
      "description": "Group mise tool updates",
      "matchManagers": ["mise"],
      "groupName": "mise tools"
    },
    {
      "description": "Group cargo crate updates",
      "matchManagers": ["cargo"],
      "groupName": "cargo tools"
    }
  ],
  "mise": {
    "enabled": true,
    "fileMatch": ["wsl/mise/config\\.toml$"]
  },
  "cargo": {
    "enabled": true,
    "fileMatch": ["wsl/cargo/Cargo\\.toml$"]
  },
  "npm": {
    "enabled": true,
    "fileMatch": ["wsl/npm/package\\.json$"]
  }
}
